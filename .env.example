# ==== Домен для HTTPS (нужен Caddy) ====
DOMAIN=bot.example.com

# ==== LINE ====
# LINE Developers Console → ваш Messaging API канал
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Необязательно: принимать сообщения только из этих групп (через запятую).
# groupId бот пришлёт в Telegram, когда его добавят в чат.
LINE_ALLOWED_GROUP_IDS=

# ==== Telegram ====
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш chat_id (узнать: напишите боту и откройте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates)
TELEGRAM_CHAT_ID=
# Кого пинговать в срочных сообщениях (необязательно).
# Несколько — через запятую: @alex,@katya
# Пинг срабатывает, только если человек есть в чате и у него есть @username.
TELEGRAM_OWNER_USERNAME=

# ==== Claude ====
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_SUMMARY=claude-sonnet-5

# ==== Поведение ====
TIMEZONE=Asia/Bangkok
SUMMARY_TIME=20:00
TARGET_LANGUAGE=русский

# instant — вложения приходят сразу; daily — пачкой вместе со сводкой
MEDIA_DELIVERY=instant
# сколько секунд копим вложения, чтобы серия фото ушла одним альбомом
MEDIA_BATCH_SECONDS=45

# слать каждое переведённое сообщение сразу (по умолчанию — нет, только сводка)
FORWARD_EVERY_MESSAGE=false
# прикладывать к сводке полный лог переписки за день
INCLUDE_FULL_LOG=false
# сколько дней хранить скачанные файлы на сервере (0 = вечно)
MEDIA_RETENTION_DAYS=90

# ==== Команды из Telegram ====
# принимать команды (/summary, /todo, /ask и прочие) из чата-получателя
ENABLE_COMMANDS=true
# за сколько дней истории отвечают /allevent, /todo, /money, /ask
HISTORY_DAYS=30

# ==== Служебное ====
# любая длинная случайная строка — защищает /admin/* ручки
ADMIN_TOKEN=
LOG_LEVEL=INFO
